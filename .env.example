# ---------------------------------------------------------------------------
# H3Gateway 环境变量示例
#
# 用法：
#   cp .env.example .env      # 然后按需修改
#   docker compose up -d      # compose 会自动读取同目录下的 .env
#
# 也可以直接把下面的变量写进 docker-compose.yml 的 environment: 段落，
# 或用 `docker run -e NAME=value` 逐个传入。
#
# 注意：后台控制台里能改的运行时设置（上游地址、并发、XFF 模式、代理等）
# 会被持久化到数据目录，并且**优先于**这里的环境变量。环境变量只在
# 首次启动（数据文件尚不存在）时决定初始值。
# ---------------------------------------------------------------------------

# ── 监听 ────────────────────────────────────────────────────────────────────
# 容器内必须监听 0.0.0.0，否则端口映射无法访问。
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8787
# debug | info | warn | error
GATEWAY_LOG_LEVEL=info

# ── 数据目录 ────────────────────────────────────────────────────────────────
# 所有可变状态都在这一个目录下：h3gateway.json（任务/密钥/设置）、
# videos/（成品 MP4 缓存）、uploads/（重投所需的输入原图）。
GATEWAY_DATA_DIR=/data
# 也可以逐个指定（默认都由 DATA_DIR 推导）：
# GATEWAY_DB=/data/h3gateway.json
# GATEWAY_VIDEOS_DIR=/data/videos
# GATEWAY_UPLOADS_DIR=/data/uploads

# ── 后台账号 ────────────────────────────────────────────────────────────────
# 首次启动时用于播种管理员账号，默认 admin / admin。
# 用默认密码登录后，控制台会被锁定，必须先改密码才能使用其它接口。
# 改完密码之后这两个变量就不再起作用（数据库里的记录优先）。
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_PASSWORD=admin

# 会话 Cookie 的签名密钥。留空则首次启动时随机生成并写入数据文件，
# 重启后依然有效。多个实例共享同一份数据时才需要显式指定。
GATEWAY_SESSION_SECRET=

# 首次启动时导入一个 API 密钥（明文）。导入后只保存哈希，无法再取回。
# GATEWAY_API_KEY=

# ── 上游 ────────────────────────────────────────────────────────────────────
GATEWAY_UPSTREAM=https://siftq.com
GATEWAY_TRIAL_BASE=/api/minimax-trial
# showcase = /api/minimax-trial/showcase/video-generation（**默认**；原项目使用的通道，
#            匿名可用。实测：整段 6.58s 都保持上传的首帧图，且 prompt 生效）
# plain    = /api/minimax-trial/video-generation（备用；匿名可用，但实测约 3.5s 后画面
#            会脱离上传的图，切到固定的 showcase 编排上，prompt 不生效）
GATEWAY_ENDPOINT_MODE=showcase
# showcase 通道的素材 ID。**该字段是 showcase 端点的必填项**，缺失会被上游拒绝
# （400 Invalid Showcase generation parameters.）。
GATEWAY_SHOWCASE_ID=case-mtqzygu8
# 提交时声明的来源站点（sourceHost 表单字段）。它与 GATEWAY_UPSTREAM 解耦：把上游
# 指向镜像或本地 mock 时，仍应声明真实来源站点。
GATEWAY_SOURCE_HOST=siftq.com
# 未显式提供 prompt 时使用的默认提示词
# GATEWAY_DEFAULT_PROMPT=

# ── 随机公网 X-Forwarded-For ────────────────────────────────────────────────
# off   关闭（所有请求共用同一个配额桶）
# ipv4  每次使用随机公网 IPv4
# ipv6  每次使用随机公网 IPv6
# mixed IPv4 / IPv6 随机混合
# auto  依据后台的实测结论自动选择（未测试时退化为 ipv4）
#
# 上游按 X-Forwarded-For 的**原始字符串**计配额（每个值每天 2 次），
# 因此随机化地址即可获得近乎无限的额度。
GATEWAY_XFF_MODE=auto
# public   真实公网地址段（额度最大化，默认）
# reserved RFC 5737 / RFC 3849 文档地址段（不会指向任何真实主机，第三方更安全）
GATEWAY_XFF_POOL=public
# 是否随机改写地址的文本写法（压缩/展开/大小写）。上游按字符串计数，
# 同一地址的不同写法会被算作不同的配额桶。
GATEWAY_XFF_VARIANTS=false

# ── 并发与重试 ──────────────────────────────────────────────────────────────
GATEWAY_MAX_CONCURRENT=4
# 单次生成从提交到出片的整体超时（秒）
GATEWAY_SUBMIT_TIMEOUT=900
# 轮询上游任务状态的间隔（秒）
GATEWAY_POLL_INTERVAL=3
# 上游把任务判为失败后，最多重投几次
GATEWAY_TASK_RESUBMITS=8
# 每次重投前的基础退避（秒），随重试次数递增，上限为基础的 5 倍
GATEWAY_RESUBMIT_BACKOFF=30
# 输入图片体积上限（字节）
GATEWAY_IMAGE_MAX_BYTES=20971520
# 本地保留的历史任务条数（超出后按时间淘汰已结束的任务）
GATEWAY_TASK_RETENTION=2000

# ── 代理 ────────────────────────────────────────────────────────────────────
# 逗号分隔。支持 socks5:// http:// https://。
# 配置代理后**不再伪造 X-Forwarded-For**（真实出口 IP 由代理决定），
# 配额将按代理的出口 IP 计算。
# 注意：代理不可达时，提交会持续重试直到超时，请确认地址可连通。
# PROXY_LIST=socks5://127.0.0.1:10808

# ── 访问控制 ────────────────────────────────────────────────────────────────
# true 时 /v1/* 一律要求 Bearer API 密钥。
# 只要存在**已启用**的密钥，/v1/* 也会自动要求密钥（即使这里是 false）。
GATEWAY_REQUIRE_API_KEY=false
# 是否允许网页工作台用 Cookie 会话直接调用 /v1/*（方便自用）
GATEWAY_STUDIO_SESSION=true
# 反向代理场景下是否信任 X-Forwarded-For 来记录客户端 IP
GATEWAY_TRUST_PROXY=false
# 对外访问地址，用于拼装返回给客户端的视频下载链接
# GATEWAY_PUBLIC_URL=https://gateway.example.com

# ── compose 专用（不会传给程序）─────────────────────────────────────────────
# 宿主机映射端口
H3_PORT=8787
# 镜像名与容器名
H3_IMAGE=h3gateway:latest
H3_CONTAINER=h3gateway
# 数据卷名
H3_VOLUME=h3gateway-data
# 写入二进制与后台显示的版本号（docker build --build-arg）
H3_VERSION=0.1.0
TZ=Asia/Shanghai
